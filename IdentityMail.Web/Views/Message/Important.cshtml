@using IdentityMail.Web.Entities
@model List<UserMessage>

@{
    ViewData["Title"] = "Önemli Mesajlar";
    Layout = "~/Views/MailLayout/Index.cshtml";
}

<div class="flex h-full flex-col">

    <div class="mb-4 flex flex-wrap items-center
                justify-between gap-4 rounded-xl
                border border-slate-200 bg-white
                px-5 py-4 shadow-sm">

        <div class="flex items-center gap-3">

            <div class="flex h-11 w-11 items-center
                        justify-center rounded-lg
                        bg-amber-50 text-amber-500">

                <span class="material-symbols-outlined text-[25px]">
                    star
                </span>

            </div>

            <div>

                <h1 class="text-xl font-bold text-slate-900">
                    Önemli Mesajlar
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Yıldızla işaretlediğiniz mesajları görüntüleyebilirsiniz.
                </p>

            </div>

        </div>

        <a href="/Message/Important/"
           title="Yenile"
           class="flex h-10 w-10 items-center
                  justify-center rounded-lg
                  text-slate-500 transition
                  hover:bg-slate-100
                  hover:text-blue-600">

            <span class="material-symbols-outlined">
                refresh
            </span>

        </a>

    </div>

    <div class="flex min-h-0 flex-1 flex-col
                overflow-hidden rounded-xl
                border border-slate-200
                bg-white shadow-sm">

        <div class="flex-1 overflow-y-auto">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var senderFullName = item.Sender != null
                    ? $"{item.Sender.FirstName} {item.Sender.LastName}"
                    : "Bilinmeyen Kullanıcı";

                    var senderEmail = item.Sender?.Email
                    ?? "E-posta bulunamadı";

                    var firstInitial =
                    !string.IsNullOrWhiteSpace(item.Sender?.FirstName)
                    ? item.Sender.FirstName.Substring(0, 1)
                    : "";

                    var lastInitial =
                    !string.IsNullOrWhiteSpace(item.Sender?.LastName)
                    ? item.Sender.LastName.Substring(0, 1)
                    : "";

                    var initials =
                    $"{firstInitial}{lastInitial}".ToUpper();

                    if (string.IsNullOrWhiteSpace(initials))
                    {
                        initials = "?";
                    }

                    var rowBackground = item.IsRead
                    ? "bg-slate-50/50"
                    : "bg-white";

                    var senderStyle = item.IsRead
                    ? "font-medium text-slate-700"
                    : "font-semibold text-slate-900";

                    var subjectStyle = item.IsRead
                    ? "font-medium text-slate-700"
                    : "font-semibold text-slate-900";

                    <div class="@rowBackground flex items-center
                                        gap-3 border-b border-slate-100
                                        px-4 py-4 transition
                                        hover:bg-slate-50">

                        <input type="checkbox"
                               name="selectedMessages"
                               value="@item.Id"
                               aria-label="@senderFullName mesajını seç"
                               class="message-checkbox shrink-0
                                              rounded border-slate-300
                                              text-blue-600
                                              focus:ring-blue-500" />

                        <form method="post"
                              action="/Message/ChangeImportantStatus/"
                              class="flex shrink-0">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="hidden"
                                   name="returnAction"
                                   value="Important" />

                            <button type="submit"
                                    title="Önemli işaretini kaldır"
                                    class="flex items-center
                                                   justify-center
                                                   text-amber-500
                                                   transition
                                                   hover:text-amber-600">

                                <span class="material-symbols-outlined"
                                      style="font-variation-settings: 'FILL' 1;">
                                    star
                                </span>

                            </button>

                        </form>

                        <form method="post"
                              action="/Message/MoveToTrash/"
                              class="flex shrink-0">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="hidden"
                                   name="returnAction"
                                   value="Important" />

                            <button type="submit"
                                    title="Çöp kutusuna taşı"
                                    onclick="return confirm('Bu mesaj çöp kutusuna taşınsın mı?');"
                                    class="flex items-center
                                                   justify-center
                                                   text-slate-400
                                                   transition
                                                   hover:text-red-600">

                                <span class="material-symbols-outlined">
                                    delete
                                </span>

                            </button>

                        </form>

                        <a href="/Message/MailDetail/@item.Id"
                           class="flex min-w-0 flex-1
                                          items-center gap-3">

                            <div class="flex h-10 w-10 shrink-0
                                                items-center justify-center
                                                rounded-full bg-amber-100
                                                font-semibold text-amber-700">

                                @initials

                            </div>

                            <div class="w-52 shrink-0 min-w-0">

                                <div class="flex items-center gap-2">

                                    @if (!item.IsRead)
                                    {
                                        <span class="h-2 w-2 shrink-0
                                                                 rounded-full bg-blue-600">
                                        </span>
                                    }

                                <p class="@senderStyle truncate">
                                    @senderFullName
                                </p>

                            </div>

                            <p class="truncate text-xs text-slate-500">
                                @senderEmail
                            </p>

                        </div>

                        <div class="min-w-0 flex-1 truncate">

                            <span class="@subjectStyle">
                                @item.Subject
                            </span>

                            <span class="text-slate-500">
                                −
                                @(string.IsNullOrWhiteSpace(item.Body)
                                                            ? "Mesaj içeriği bulunmuyor."
                                                            : item.Body)
                                                                    </span>

                        </div>

                        <span class="w-24 shrink-0 text-right
                                             text-sm
                                             @(item.IsRead
                                                                           ? "text-slate-500"
                                                                           : "font-semibold text-slate-700")">

                        @if (item.SendTime.Date == DateTime.Today)
                                {
                                    @item.SendTime.ToString("HH:mm")
                                }
                                else if (item.SendTime.Date ==
                                DateTime.Today.AddDays(-1))
                                {
                                    <text>Dün</text>
                                }
                                else if (item.SendTime.Year ==
                                DateTime.Today.Year)
                                {
                                    @item.SendTime.ToString("dd MMM")
                                }
                                else
                                {
                                    @item.SendTime.ToString("dd.MM.yyyy")
                                }

                            </span>

                        </a>

                    </div>
                }
            }
            else
            {
                <div class="flex min-h-80 flex-col
                                items-center justify-center
                                px-6 py-16 text-center">

                    <div class="mb-4 flex h-16 w-16
                                    items-center justify-center
                                    rounded-full bg-amber-50">

                        <span class="material-symbols-outlined
                                         text-3xl text-amber-500">
                            star
                        </span>

                    </div>

                    <h2 class="text-lg font-semibold text-slate-800">
                        Önemli mesajınız yok
                    </h2>

                    <p class="mt-2 max-w-md text-sm text-slate-500">
                        Gelen kutusunda yıldızla işaretlediğiniz mesajlar
                        burada görüntülenecek.
                    </p>

                    <a href="/Message/Index/"
                       class="mt-5 flex items-center gap-2
                                  rounded-lg bg-blue-600
                                  px-5 py-2.5 text-sm
                                  font-semibold text-white
                                  transition hover:bg-blue-700">

                        <span class="material-symbols-outlined text-[19px]">
                            inbox
                        </span>

                        <span>Gelen Kutusuna Git</span>

                    </a>

                </div>
            }

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="flex items-center justify-between
                            border-t border-slate-200
                            px-4 py-3">

                <p class="text-sm text-slate-500">
                    Toplam @Model.Count önemli mesaj
                </p>

            </div>
        }

    </div>

</div>