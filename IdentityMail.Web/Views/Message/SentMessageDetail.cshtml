@using IdentityMail.Web.Entities
@model UserMessage

@{
    ViewData["Title"] = "Gönderilen Mesaj Detayı";
    Layout = "~/Views/MailLayout/Index.cshtml";

    var receiverFullName = Model.Receiver != null
        ? $"{Model.Receiver.FirstName} {Model.Receiver.LastName}"
        : "Bilinmeyen Kullanıcı";

    var receiverEmail = Model.Receiver?.Email
        ?? "E-posta bulunamadı";

    var firstInitial =
        !string.IsNullOrWhiteSpace(Model.Receiver?.FirstName)
            ? Model.Receiver.FirstName.Substring(0, 1)
            : "";

    var lastInitial =
        !string.IsNullOrWhiteSpace(Model.Receiver?.LastName)
            ? Model.Receiver.LastName.Substring(0, 1)
            : "";

    var initials = $"{firstInitial}{lastInitial}".ToUpper();

    if (string.IsNullOrWhiteSpace(initials))
    {
        initials = "?";
    }
}

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">

    <div class="flex flex-wrap items-center justify-between
                gap-4 border-b border-slate-200 pb-4">

        <div class="flex items-center gap-2">

            <a href="/Message/Sent/"
               title="Gönderilen mesajlara dön"
               class="flex h-10 w-10 items-center justify-center
                      rounded-full text-slate-500
                      transition hover:bg-slate-100
                      hover:text-blue-600">

                <span class="material-symbols-outlined">
                    arrow_back
                </span>

            </a>

        </div>

        <div class="flex items-center gap-4">

            <span class="text-sm text-slate-500">
                @Model.SendTime.ToString("dd MMMM yyyy, HH:mm")
            </span>

            <a href="/Message/SendMail/?receiverMail=@receiverEmail"
               class="flex items-center gap-2 rounded-lg
                      border border-slate-200 bg-white
                      px-4 py-2 text-sm font-semibold
                      text-slate-700 transition
                      hover:border-blue-200
                      hover:bg-blue-50
                      hover:text-blue-600">

                <span class="material-symbols-outlined text-[19px]">
                    forward
                </span>

                <span>Tekrar Gönder</span>

            </a>

        </div>

    </div>

    <div>

        <p class="mb-2 text-xs font-semibold
                  uppercase tracking-wider text-emerald-600">
            Gönderilen mesaj
        </p>

        <h1 class="break-words text-2xl font-bold
                   tracking-tight text-slate-900
                   md:text-3xl">

            @Model.Subject

        </h1>

    </div>

    <div class="flex items-center gap-4 rounded-xl
                border border-slate-200 bg-white
                p-4 shadow-sm">

        <div class="flex h-12 w-12 shrink-0
                    items-center justify-center
                    rounded-full bg-emerald-100
                    font-semibold text-emerald-600">

            @initials

        </div>

        <div class="min-w-0 flex-1">

            <div class="flex flex-wrap items-center
                        justify-between gap-2">

                <h2 class="truncate text-base
                           font-semibold text-slate-900">

                    @receiverFullName

                </h2>

                <span class="truncate text-sm text-slate-500">
                    &lt;@receiverEmail&gt;
                </span>

            </div>

            <div class="mt-1 flex items-center gap-1
                        text-sm text-slate-500">

                <span>Alıcı:</span>

                <span class="font-medium text-slate-700">
                    @receiverFullName
                </span>

            </div>

        </div>

    </div>

    <article class="min-h-72 whitespace-pre-wrap
                    rounded-xl border border-slate-200
                    bg-white p-6 text-base
                    leading-7 text-slate-700
                    shadow-sm">
        @Model.Body
    </article>

    <div class="flex flex-col items-center justify-between
                gap-4 border-t border-slate-200 pt-5
                sm:flex-row">

        <div class="flex items-center gap-2
                    text-sm text-slate-500">

            @if (Model.IsRead)
            {
                <span class="material-symbols-outlined
                                 text-[19px] text-blue-600">
                    done_all
                </span>

                <span>Alıcı tarafından okundu</span>
            }
            else
            {
                <span class="material-symbols-outlined
                                 text-[19px] text-slate-400">
                    done
                </span>

                <span>Henüz okunmadı</span>
            }

        </div>

        <div class="flex w-full items-center gap-3
                    sm:w-auto">

            <a href="/Message/Sent/"
               class="flex flex-1 items-center justify-center
                      gap-2 rounded-lg border
                      border-slate-200 bg-white
                      px-5 py-2.5 text-sm font-semibold
                      text-slate-700 transition
                      hover:bg-slate-100 sm:flex-none">

                <span class="material-symbols-outlined text-[19px]">
                    arrow_back
                </span>

                <span>Gönderilenlere Dön</span>

            </a>

            <a href="/Message/SendMail/?receiverMail=@receiverEmail"
               class="flex flex-1 items-center justify-center
                      gap-2 rounded-lg bg-blue-600
                      px-5 py-2.5 text-sm font-semibold
                      text-white transition
                      hover:bg-blue-700 sm:flex-none">

                <span class="material-symbols-outlined text-[19px]">
                    forward
                </span>

                <span>Tekrar Gönder</span>

            </a>

        </div>

    </div>

</div>