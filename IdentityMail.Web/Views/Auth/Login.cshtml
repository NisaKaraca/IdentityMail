@model IdentityMail.Web.DTOs.UserDtos.LoginDto

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>Giriş Yap - IdentityMail</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#434655",
                        "surface-variant": "#e1e2ed",
                        "on-background": "#191b23",
                        "background": "#faf8ff",
                        "on-primary": "#ffffff",
                        "primary-container": "#2563eb",
                        "on-primary-fixed-variant": "#003ea8",
                        "on-surface": "#191b23",
                        "primary": "#004ac6",
                        "outline-variant": "#c3c6d7",
                        "outline": "#737686",
                        "error": "#ba1a1a"
                    },

                    borderRadius: {
                        lg: "0.5rem",
                        xl: "0.75rem"
                    },

                    spacing: {
                        xs: "8px",
                        sm: "12px",
                        md: "16px",
                        lg: "24px",
                        xl: "32px"
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>

</head>

<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-md">

    <div class="w-full max-w-md">

        <div class="flex flex-col items-center justify-center mb-xl">

            <div class="w-12 h-12 bg-primary-container rounded-lg flex items-center justify-center mb-sm shadow-sm">

                <span class="material-symbols-outlined text-white text-2xl"
                      style="font-variation-settings: 'FILL' 1;">
                    mail
                </span>

            </div>

            <h1 class="text-2xl font-bold text-primary">
                IdentityMail
            </h1>

        </div>


        <div class="bg-surface-container-lowest rounded-xl shadow-md border border-surface-variant p-xl">

            <div class="mb-lg text-center">

                <h2 class="text-2xl font-semibold mb-xs text-on-surface">
                    Giriş Yap
                </h2>

                <p class="text-sm text-on-surface-variant">
                    Hesabınıza giriş yaparak mesajlarınıza erişebilirsiniz.
                </p>

            </div>

            <div asp-validation-summary="ModelOnly"
                 class="text-error text-sm mb-md">
            </div>

            <form method="post" class="space-y-md">

                <div>

                    <label asp-for="Email"
                           class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">
                        E-posta
                    </label>

                    <div class="relative">

                        <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                            <span class="material-symbols-outlined text-outline">
                                mail
                            </span>

                        </div>

                        <input asp-for="Email"
                               type="email"
                               placeholder=" ornek@sirket.com"
                               class="block w-full pl-xl pr-sm py-sm
                                  bg-surface-container-lowest
                                  border border-surface-variant
                                  rounded-lg
                                  focus:ring-2
                                  focus:ring-primary
                                  focus:border-primary
                                  text-on-surface
                                  placeholder:text-outline
                                  transition-colors" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-error text-sm mt-1 block">
                    </span>

                </div>

                <div>

                    <div class="flex items-center justify-between mb-xs">

                        <label asp-for="Password"
                               class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant">
                            Şifre
                        </label>

                        <a href="/Login/ForgotPassword"
                           class="text-sm text-primary hover:text-on-primary-fixed-variant transition-colors">

                            Şifremi Unuttum

                        </a>

                    </div>

                    <div class="relative">

                        <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                            <span class="material-symbols-outlined text-outline">
                                lock
                            </span>

                        </div>

                        <input asp-for="Password"
                               type="password"
                               placeholder=" ••••••••"
                               class="block w-full pl-xl pr-sm py-sm
                                  bg-surface-container-lowest
                                  border border-surface-variant
                                  rounded-lg
                                  focus:ring-2
                                  focus:ring-primary
                                  focus:border-primary
                                  text-on-surface
                                  placeholder:text-outline
                                  transition-colors" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-error text-sm mt-1 block">
                    </span>

                </div>

                <button type="submit"
                        class="w-full flex justify-center
                           py-sm px-md
                           border border-transparent
                           rounded-lg
                           shadow-sm
                           font-semibold
                           text-on-primary
                           bg-primary
                           hover:bg-on-primary-fixed-variant
                           focus:outline-none
                           focus:ring-2
                           focus:ring-offset-2
                           focus:ring-primary
                           transition-colors
                           mt-lg">

                    Giriş Yap

                </button>

            </form>

            <div class="mt-lg flex items-center justify-between">

                <span class="w-1/4 border-b border-surface-variant"></span>

                <span class="text-sm text-outline px-sm">
                    veya
                </span>

                <span class="w-1/4 border-b border-surface-variant"></span>

            </div>

            <div class="mt-md text-center">

                <p class="text-sm text-on-surface-variant">

                    Henüz bir hesabınız yok mu?

                    <a href="/Auth/Register"
                       class="text-primary hover:text-on-primary-fixed-variant font-bold ml-xs transition-colors">

                        Kayıt Ol

                    </a>

                </p>

            </div>

        </div>

    </div>

</body>
</html>
