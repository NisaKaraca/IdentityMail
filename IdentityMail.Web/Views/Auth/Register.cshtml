@model RegisterDto

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>

<html class="light" lang="tr">
<head>

    <meta charset="utf-8" />

    <meta content="width=device-width, initial-scale=1.0"
          name="viewport" />

    <title>Kayıt Ol - IdentityMail</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />

    <script id="tailwind-config">

        tailwind.config = {

            darkMode: "class",

            theme: {

                extend: {

                    colors: {

                        "secondary-fixed": "#d3e4fe",
                        "on-secondary-fixed-variant": "#38485d",
                        "secondary": "#505f76",
                        "surface-container-lowest": "#ffffff",
                        "secondary-container": "#d0e1fb",
                        "outline": "#737686",
                        "on-surface-variant": "#434655",
                        "surface-variant": "#e1e2ed",
                        "primary-fixed": "#dbe1ff",
                        "error": "#ba1a1a",
                        "on-primary": "#ffffff",
                        "on-background": "#191b23",
                        "background": "#faf8ff",
                        "primary-container": "#2563eb",
                        "on-primary-fixed-variant": "#003ea8",
                        "on-surface": "#191b23",
                        "primary": "#004ac6",
                        "outline-variant": "#c3c6d7"

                    },

                    borderRadius: {

                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"

                    },

                    spacing: {

                        "sm": "12px",
                        "xs": "8px",
                        "md": "16px",
                        "lg": "24px",
                        "xl": "32px"

                    }

                }

            }

        }

    </script>

    <style>

        body {
            font-family: 'Inter', sans-serif;
        }

    </style>

</head>


<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-md">

    <div class="w-full max-w-lg">

        <div class="flex flex-col items-center justify-center mb-lg">

            <div class="w-12 h-12 bg-primary-container rounded-lg flex items-center justify-center mb-sm shadow-sm">

                <span class="material-symbols-outlined text-white text-2xl font-bold"
                      style="font-variation-settings: 'FILL' 1;">

                    mail

                </span>

            </div>

            <h1 class="text-2xl font-bold text-primary">

                IdentityMail

            </h1>

        </div>

        <div class="bg-surface-container-lowest rounded-xl shadow-md border border-surface-variant p-xl">


            <div class="mb-lg text-center">

                <h2 class="text-2xl font-semibold mb-xs text-on-surface">

                    Hesap Oluştur

                </h2>

                <p class="text-sm text-on-surface-variant">

                    Mesajlaşmaya başlamak için yeni hesabınızı oluşturun.

                </p>

            </div>

            <div class="text-error text-sm mb-md">

                @Html.ValidationSummary()

            </div>


            <form method="post"
                  enctype="multipart/form-data"
                  class="space-y-md">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">

                    <div>

                        <label asp-for="FirstName"
                               class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                            Ad

                        </label>


                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                                <span class="material-symbols-outlined text-outline">

                                    person

                                </span>

                            </div>


                            <input asp-for="FirstName"
                                   placeholder=" Adınızı girin"
                                   class="block w-full
                                          pl-xl pr-sm py-sm
                                          border border-surface-variant
                                          rounded-lg
                                          focus:ring-2
                                          focus:ring-primary
                                          focus:border-primary
                                          text-on-surface
                                          placeholder:text-outline
                                          transition-colors" />

                        </div>

                        <span asp-validation-for="FirstName"
                              class="text-error text-sm mt-1 block">
                        </span>

                    </div>

                    <div>

                        <label asp-for="LastName"
                               class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                            Soyad

                        </label>


                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                                <span class="material-symbols-outlined text-outline">

                                    person

                                </span>

                            </div>


                            <input asp-for="LastName"
                                   placeholder=" Soyadınızı girin"
                                   class="block w-full
                                          pl-xl pr-sm py-sm
                                          border border-surface-variant
                                          rounded-lg
                                          focus:ring-2
                                          focus:ring-primary
                                          focus:border-primary
                                          text-on-surface
                                          placeholder:text-outline
                                          transition-colors" />

                        </div>

                        <span asp-validation-for="LastName"
                              class="text-error text-sm mt-1 block">
                        </span>

                    </div>

                </div>

                <div>

                    <label asp-for="Email"
                           class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                        E-posta

                    </label>


                    <div class="relative">

                        <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                            <span class="material-symbols-outlined text-outline">

                                mail

                            </span>

                        </div>


                        <input asp-for="Email"
                               type="email"
                               placeholder=" ornek@sirket.com"
                               class="block w-full
                                      pl-xl pr-sm py-sm
                                      border border-surface-variant
                                      rounded-lg
                                      focus:ring-2
                                      focus:ring-primary
                                      focus:border-primary
                                      text-on-surface
                                      placeholder:text-outline
                                      transition-colors" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-error text-sm mt-1 block">
                    </span>

                </div>
                <div>

                    <label asp-for="UserName"
                           class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                        Kullanıcı Adı

                    </label>


                    <div class="relative">

                        <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                            <span class="material-symbols-outlined text-outline">

                                person

                            </span>

                        </div>


                        <input asp-for="UserName"
                               placeholder=" örn: sirket123"
                               class="block w-full
                                      pl-xl pr-sm py-sm
                                      border border-surface-variant
                                      rounded-lg
                                      focus:ring-2
                                      focus:ring-primary
                                      focus:border-primary
                                      text-on-surface
                                      placeholder:text-outline
                                      transition-colors" />

                    </div>

                    <span asp-validation-for="UserName"
                          class="text-error text-sm mt-1 block">
                    </span>

                </div>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-md">



                    <div>

                        <label asp-for="Password"
                               class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                            Şifre

                        </label>


                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                                <span class="material-symbols-outlined text-outline">

                                    lock

                                </span>

                            </div>


                            <input asp-for="Password"
                                   type="password"
                                   placeholder=" ••••••••"
                                   class="block w-full
                                          pl-xl pr-sm py-sm
                                          border border-surface-variant
                                          rounded-lg
                                          focus:ring-2
                                          focus:ring-primary
                                          focus:border-primary
                                          text-on-surface
                                          placeholder:text-outline
                                          transition-colors" />

                        </div>

                        <span asp-validation-for="Password"
                              class="text-error text-sm mt-1 block">
                        </span>

                    </div>


                    <div>

                        <label asp-for="ConfirmPassword"
                               class="block text-xs font-semibold uppercase tracking-wide text-on-surface-variant mb-xs">

                            Şifre Tekrar

                        </label>


                        <div class="relative">

                            <div class="absolute inset-y-0 left-0 pl-sm flex items-center pointer-events-none">

                                <span class="material-symbols-outlined text-outline">

                                    lock

                                </span>

                            </div>


                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   placeholder=" ••••••••"
                                   class="block w-full
                                          pl-xl pr-sm py-sm
                                          border border-surface-variant
                                          rounded-lg
                                          focus:ring-2
                                          focus:ring-primary
                                          focus:border-primary
                                          text-on-surface
                                          placeholder:text-outline
                                          transition-colors" />

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="text-error text-sm mt-1 block">
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="w-full flex items-center justify-center gap-2
                               py-sm px-md
                               rounded-lg
                               shadow-sm
                               font-semibold
                               text-white
                               bg-primary
                               hover:bg-on-primary-fixed-variant
                               focus:outline-none
                               focus:ring-2
                               focus:ring-offset-2
                               focus:ring-primary
                               transition-colors
                               mt-lg">

                    Kayıt Ol

                    <span class="material-symbols-outlined text-lg">

                        arrow_forward

                    </span>

                </button>

            </form>

            <div class="mt-lg flex items-center justify-between">

                <span class="w-1/4 border-b border-surface-variant"></span>

                <span class="text-sm text-outline px-sm">

                    veya

                </span>

                <span class="w-1/4 border-b border-surface-variant"></span>

            </div>

            <div class="mt-md text-center">

                <p class="text-sm text-on-surface-variant">

                    Zaten bir hesabınız var mı?

                    <a href="/Auth/Login"
                       class="text-primary font-bold ml-xs hover:text-on-primary-fixed-variant transition-colors">

                        Giriş Yap

                    </a>

                </p>
            </div>

        </div>

    </div>

    <script>

        function previewImage(event) {

            const input = event.target;
            const preview = document.getElementById("imagePreview");
            const icon = document.getElementById("profileIcon");

            if (input.files && input.files[0]) {

                const reader = new FileReader();

                reader.onload = function (e) {

                    preview.src = e.target.result;
                    preview.classList.remove("hidden");
                    icon.classList.add("hidden");

                };

                reader.readAsDataURL(input.files[0]);

            }

        }

    </script>

</body>

</html>