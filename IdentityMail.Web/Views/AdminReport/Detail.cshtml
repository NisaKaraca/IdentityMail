@model IdentityMail.Web.DTOs.AdminReportDtos.AdminReportDetailDto

@{
    ViewData["Title"] = "Şikâyet Detayı";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<a asp-controller="AdminReport"
   asp-action="Index"
   class="mb-md inline-flex items-center gap-xs
          text-sm font-semibold text-primary">

    <span class="material-symbols-outlined">
        arrow_back
    </span>

    Şikâyetlere Dön
</a>

<div class="grid grid-cols-1 gap-lg lg:grid-cols-3">

    <section class="lg:col-span-2 overflow-hidden
                    rounded-xl border border-surface-variant
                    bg-surface shadow-sm">

        <div class="border-b border-surface-variant p-lg">

            <div class="mb-sm flex items-center justify-between">

                <span class="rounded-full bg-red-50
                             px-sm py-1 text-xs font-semibold
                             text-red-700">
                    @Model.Reason
                </span>

                <span class="rounded-full px-sm py-1
                             text-xs font-semibold
                             @(Model.IsResolved
                                                       ? "bg-green-100 text-green-700"
                                                       : "bg-yellow-100 text-yellow-700")">

                    @(Model.IsResolved ? "Çözüldü" : "Bekliyor")
                </span>

            </div>

            <h1 class="text-2xl font-bold text-on-surface">
                @Model.Subject
            </h1>

            <p class="mt-xs text-sm text-on-surface-variant">
                Gönderilme: @Model.MessageSendTime.ToString("dd.MM.yyyy HH:mm")
            </p>

        </div>

        <div class="p-lg">

            <h2 class="mb-sm font-semibold text-on-surface">
                Mesaj içeriği
            </h2>

            <p class="whitespace-pre-wrap break-words
                      leading-7 text-on-surface">
                @Model.MessageBody
            </p>

        </div>

    </section>

    <aside class="flex flex-col gap-lg">

        <section class="rounded-xl border border-surface-variant
                        bg-surface p-lg shadow-sm">

            <h2 class="mb-md font-semibold">Şikâyet Bilgileri</h2>

            <div class="flex flex-col gap-sm text-sm">

                <div>
                    <p class="text-on-surface-variant">Şikâyet eden</p>
                    <p class="font-semibold">@Model.ReportedByFullName</p>
                    <p>@Model.ReportedByEmail</p>
                </div>

                <div>
                    <p class="text-on-surface-variant">Gönderen</p>
                    <p class="font-semibold">@Model.SenderFullName</p>
                    <p>@Model.SenderEmail</p>
                </div>

                <div>
                    <p class="text-on-surface-variant">Alıcı</p>
                    <p class="font-semibold">@Model.ReceiverFullName</p>
                    <p>@Model.ReceiverEmail</p>
                </div>

                <div>
                    <p class="text-on-surface-variant">Açıklama</p>

                    <p class="mt-1">
                        @(string.IsNullOrWhiteSpace(Model.Description)
                                                ? "Açıklama eklenmemiş."
                                                : Model.Description)
                    </p>
                </div>

            </div>

        </section>

        <section class="rounded-xl border border-surface-variant
                        bg-surface p-lg shadow-sm">

            @if (!Model.IsResolved)
            {
                <form asp-controller="AdminReport"
                      asp-action="Resolve"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="w-full rounded-lg bg-green-600
                                       px-md py-sm text-sm font-semibold
                                       text-white">
                        Çözüldü Olarak İşaretle
                    </button>

                </form>
            }
            else
            {
                <form asp-controller="AdminReport"
                      asp-action="Reopen"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="w-full rounded-lg bg-yellow-500
                                       px-md py-sm text-sm font-semibold
                                       text-white">
                        Yeniden İncelemeye Al
                    </button>

                </form>
            }

        </section>

    </aside>

</div>