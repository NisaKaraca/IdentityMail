@using IdentityMail.Web.DTOs.SettingsDtos
@model SettingsPageDto

@{
	ViewData["Title"] = "Profil Ayarları";
	Layout = "~/Views/MailLayout/Index.cshtml";

	var firstInitial =
		!string.IsNullOrWhiteSpace(Model.Profile.FirstName)
			? Model.Profile.FirstName.Substring(0, 1)
			: "";

	var lastInitial =
		!string.IsNullOrWhiteSpace(Model.Profile.LastName)
			? Model.Profile.LastName.Substring(0, 1)
			: "";

	var initials = $"{firstInitial}{lastInitial}".ToUpper();

	if (string.IsNullOrWhiteSpace(initials))
	{
		initials = "?";
	}
}

<div class="mx-auto w-full max-w-6xl">

	<div class="mb-6">

		<h1 class="text-2xl font-bold text-slate-900 md:text-3xl">
			Profil Ayarları
		</h1>

		<p class="mt-2 text-sm text-slate-500">
			Kişisel bilgilerinizi ve hesap güvenliğinizi yönetin.
		</p>

	</div>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="mb-6 flex items-center gap-3 rounded-lg
	                        border border-emerald-200 bg-emerald-50
	                        px-4 py-3 text-sm text-emerald-700">

			<span class="material-symbols-outlined">
				check_circle
			</span>

			<span>@TempData["SuccessMessage"]</span>

		</div>
	}

	<div asp-validation-summary="ModelOnly"
		 class="mb-6 text-sm text-red-600">
	</div>

	<div class="grid grid-cols-1 gap-6 lg:grid-cols-12">

		<section class="rounded-xl border border-slate-200
                        bg-white p-6 shadow-sm lg:col-span-7">

			<h2 class="mb-6 text-lg font-semibold text-slate-900">
				Profilim
			</h2>

			<form method="post"
				  action="/Settings/UpdateProfile/">

				@Html.AntiForgeryToken()

				<div class="mb-8 flex flex-col
            items-center gap-5 sm:flex-row">

					<div class="shrink-0">

						@if (!string.IsNullOrWhiteSpace(
												Model.Profile.ProfileImageUrl))
						{
							<img id="profileImagePreview"
								 src="@Model.Profile.ProfileImageUrl"
								 onerror="this.src='/images/default-user.png';"
								 alt="Profil fotoğrafı"
								 class="h-24 w-24 rounded-full
	                        border-4 border-slate-100
	                        object-cover shadow-sm" />
						}
						else
						{
							<div id="initialsPreview"
								 class="flex h-24 w-24
	                        items-center justify-center
	                        rounded-full border-4
	                        border-slate-100
	                        bg-blue-100 text-2xl
	                        font-bold text-blue-600">

								@initials

							</div>

							<img id="profileImagePreview"
								 src=""
								 alt="Profil fotoğrafı"
								 class="hidden h-24 w-24 rounded-full
	                        border-4 border-slate-100
	                        object-cover shadow-sm" />
						}

					</div>

					<div class="w-full">

						<label for="ProfileImageUrl"
							   class="mb-2 block text-sm
                      font-semibold text-slate-700">

							Profil görseli bağlantısı

						</label>

						<input id="ProfileImageUrl"
							   name="ProfileImageUrl"
							   value="@Model.Profile.ProfileImageUrl"
							   type="text"
							   placeholder="https://example.com/profil.jpg"
							   class="w-full rounded-lg
                      border border-slate-200
                      px-4 py-2.5 text-sm
                      outline-none transition
                      focus:border-blue-500
                      focus:ring-1
                      focus:ring-blue-500" />

						<span asp-validation-for="Profile.ProfileImageUrl"
							  class="mt-1 block text-sm text-red-600">
						</span>

						<p class="mt-2 text-xs text-slate-500">
							İnternetteki görselin doğrudan bağlantısını giriniz.
						</p>

					</div>

				</div>

				<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

					<div>

						<label class="mb-2 block text-sm
                                      font-semibold text-slate-700">
							Ad
						</label>

						<input name="FirstName"
							   value="@Model.Profile.FirstName"
							   type="text"
							   class="w-full rounded-lg border
                                      border-slate-200 px-4 py-2.5
                                      text-sm outline-none
                                      focus:border-blue-500
                                      focus:ring-1
                                      focus:ring-blue-500" />

						<span asp-validation-for="Profile.FirstName"
							  class="mt-1 block text-sm text-red-600">
						</span>

					</div>

					<div>

						<label class="mb-2 block text-sm
                                      font-semibold text-slate-700">
							Soyad
						</label>

						<input name="LastName"
							   value="@Model.Profile.LastName"
							   type="text"
							   class="w-full rounded-lg border
                                      border-slate-200 px-4 py-2.5
                                      text-sm outline-none
                                      focus:border-blue-500
                                      focus:ring-1
                                      focus:ring-blue-500" />

						<span asp-validation-for="Profile.LastName"
							  class="mt-1 block text-sm text-red-600">
						</span>

					</div>

				</div>

				<div class="mt-5">

					<label class="mb-2 block text-sm
                                  font-semibold text-slate-700">
						E-posta adresi
					</label>

					<input name="Email"
						   value="@Model.Profile.Email"
						   type="email"
						   class="w-full rounded-lg border
                                  border-slate-200 px-4 py-2.5
                                  text-sm outline-none
                                  focus:border-blue-500
                                  focus:ring-1
                                  focus:ring-blue-500" />

					<span asp-validation-for="Profile.Email"
						  class="mt-1 block text-sm text-red-600">
					</span>

				</div>

				<div class="mt-6 flex justify-end">

					<button type="submit"
							class="flex items-center gap-2
                                   rounded-lg bg-blue-600
                                   px-5 py-2.5 text-sm
                                   font-semibold text-white
                                   transition hover:bg-blue-700">

						<span class="material-symbols-outlined text-[19px]">
							save
						</span>

						<span>Değişiklikleri Kaydet</span>

					</button>

				</div>

			</form>

		</section>

		<section class="rounded-xl border border-slate-200
                        bg-white p-6 shadow-sm lg:col-span-5">

			<h2 class="text-lg font-semibold text-slate-900">
				Şifre Değiştir
			</h2>

			<p class="mb-6 mt-2 text-sm text-slate-500">
				Hesabınızın güvenliği için güçlü bir şifre kullanın.
			</p>

			<form method="post"
				  action="/Settings/ChangePassword/"
				  class="space-y-5">

				@Html.AntiForgeryToken()

				<div>

					<label class="mb-2 block text-sm
                                  font-semibold text-slate-700">
						Mevcut şifre
					</label>

					<input name="CurrentPassword"
						   type="password"
						   placeholder="••••••••"
						   class="w-full rounded-lg border
                                  border-slate-200 px-4 py-2.5
                                  text-sm outline-none
                                  focus:border-blue-500
                                  focus:ring-1
                                  focus:ring-blue-500" />

					<span asp-validation-for="Password.CurrentPassword"
						  class="mt-1 block text-sm text-red-600">
					</span>

				</div>

				<div>

					<label class="mb-2 block text-sm
                                  font-semibold text-slate-700">
						Yeni şifre
					</label>

					<input name="NewPassword"
						   type="password"
						   placeholder="Yeni şifrenizi girin"
						   class="w-full rounded-lg border
                                  border-slate-200 px-4 py-2.5
                                  text-sm outline-none
                                  focus:border-blue-500
                                  focus:ring-1
                                  focus:ring-blue-500" />

					<span asp-validation-for="Password.NewPassword"
						  class="mt-1 block text-sm text-red-600">
					</span>

				</div>

				<div>

					<label class="mb-2 block text-sm
                                  font-semibold text-slate-700">
						Yeni şifre tekrar
					</label>

					<input name="ConfirmPassword"
						   type="password"
						   placeholder="Yeni şifrenizi tekrar girin"
						   class="w-full rounded-lg border
                                  border-slate-200 px-4 py-2.5
                                  text-sm outline-none
                                  focus:border-blue-500
                                  focus:ring-1
                                  focus:ring-blue-500" />

					<span asp-validation-for="Password.ConfirmPassword"
						  class="mt-1 block text-sm text-red-600">
					</span>

				</div>

				<button type="submit"
						class="flex w-full items-center
                               justify-center gap-2 rounded-lg
                               border-2 border-blue-600
                               px-5 py-2.5 text-sm
                               font-semibold text-blue-600
                               transition hover:bg-blue-600
                               hover:text-white">

					<span class="material-symbols-outlined text-[19px]">
						lock_reset
					</span>

					<span>Şifreyi Güncelle</span>

				</button>

			</form>

		</section>

	</div>

</div>

@section Scripts {

	<partial name="_ValidationScriptsPartial" />

	<script>
		document.addEventListener("DOMContentLoaded", function () {

			const imageUrlInput =
				document.getElementById("ProfileImageUrl");

			const imagePreview =
				document.getElementById("profileImagePreview");

			const initialsPreview =
				document.getElementById("initialsPreview");

			if (!imageUrlInput || !imagePreview) {
				return;
			}

			imageUrlInput.addEventListener("input", function () {

				const imageUrl =
					imageUrlInput.value.trim();

				if (!imageUrl) {
					imagePreview.classList.add("hidden");

					if (initialsPreview) {
						initialsPreview.classList.remove("hidden");
					}

					return;
				}

				imagePreview.src = imageUrl;
				imagePreview.classList.remove("hidden");

				if (initialsPreview) {
					initialsPreview.classList.add("hidden");
				}

			});

		});
	</script>

}