@using IdentityMail.Web.DTOs.UserDtos
@model MailTopNavbarDto

<header class="fixed left-0 right-0 top-0 z-40
               flex h-16 items-center justify-between
               border-b border-slate-200 bg-white
               px-6 shadow-sm md:left-64">

    <div class="relative w-full max-w-xl">

        <span class="material-symbols-outlined
                     absolute left-3 top-1/2
                     -translate-y-1/2 text-slate-400">
            search
        </span>

        <input type="text"
               placeholder="Mesajlarda ara..."
               class="w-full rounded-lg border
                      border-slate-200 bg-slate-50
                      py-2.5 pl-11 pr-4 text-sm
                      text-slate-700 outline-none
                      transition placeholder:text-slate-400
                      focus:border-blue-500
                      focus:bg-white focus:ring-1
                      focus:ring-blue-500" />

    </div>

    <div class="ml-6 flex shrink-0 items-center gap-4">

        <button type="button"
                title="Bildirimler"
                class="relative flex h-10 w-10
                       items-center justify-center
                       rounded-full text-slate-600
                       transition hover:bg-slate-100
                       hover:text-blue-600">

            <span class="material-symbols-outlined">
                notifications
            </span>

            <span class="absolute right-2 top-2
                         h-2 w-2 rounded-full
                         border border-white bg-red-500">
            </span>

        </button>

        <div class="flex items-center gap-3">

            <img src="@Model.ProfileImageUrl"
                 onerror="this.src='/images/default-user.png';"
                 class="h-9 w-9 rounded-full
            border border-slate-200 object-cover"
                 alt="@Model.FullName" />

            <div class="hidden lg:block">

                <p class="max-w-40 truncate
                          text-sm font-semibold
                          text-slate-800">

                    @Model.FullName

                </p>

                <p class="max-w-40 truncate
                          text-xs text-slate-500">

                    @Model.Email

                </p>

            </div>

        </div>

    </div>

</header>