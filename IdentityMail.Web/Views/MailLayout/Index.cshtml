@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IdentityMail</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
          rel="stylesheet" />

    <style>
        body {
            font-family: "Inter", sans-serif;
        }

        .material-symbols-outlined {
            font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
        }
    </style>
</head>

<body class="m-0 bg-slate-50 text-slate-900">

    @await Component.InvokeAsync("_MailSidebar")
    @await Component.InvokeAsync("_MailTopNavbar")

    <main class="min-h-screen pt-16 md:ml-64">

        <div class="h-[calc(100vh-4rem)] overflow-y-auto p-6">

            @RenderBody()

        </div>

    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>