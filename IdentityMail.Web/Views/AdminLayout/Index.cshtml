<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IdentityMail Admin</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet" />

    <script>
        tailwind.config = {
            darkMode: "class",

            theme: {
                extend: {

                    colors: {
                        "secondary-fixed": "#d3e4fe",
                        "on-secondary-fixed-variant": "#38485d",
                        "secondary": "#505f76",
                        "tertiary-fixed-dim": "#ffb596",
                        "on-tertiary-container": "#ffede6",
                        "surface-container-lowest": "#ffffff",
                        "inverse-on-surface": "#f0f0fb",
                        "secondary-container": "#d0e1fb",
                        "outline": "#737686",
                        "surface-bright": "#faf8ff",
                        "on-surface-variant": "#434655",
                        "surface-variant": "#e1e2ed",
                        "on-secondary-fixed": "#0b1c30",
                        "tertiary-fixed": "#ffdbcd",
                        "primary-fixed": "#dbe1ff",
                        "surface-container-highest": "#e1e2ed",
                        "error": "#ba1a1a",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "surface-container-low": "#f3f3fe",
                        "on-background": "#191b23",
                        "on-primary-fixed": "#00174b",
                        "background": "#faf8ff",
                        "secondary-fixed-dim": "#b7c8e1",
                        "on-error-container": "#93000a",
                        "on-secondary-container": "#54647a",
                        "inverse-surface": "#2e3039",
                        "on-tertiary": "#ffffff",
                        "on-error": "#ffffff",
                        "tertiary-container": "#bc4800",
                        "on-secondary": "#ffffff",
                        "primary-container": "#2563eb",
                        "surface": "#faf8ff",
                        "inverse-primary": "#b4c5ff",
                        "tertiary": "#943700",
                        "on-primary-fixed-variant": "#003ea8",
                        "on-surface": "#191b23",
                        "surface-container-high": "#e7e7f3",
                        "surface-dim": "#d9d9e5",
                        "on-tertiary-fixed-variant": "#7d2d00",
                        "primary": "#004ac6",
                        "primary-fixed-dim": "#b4c5ff",
                        "on-primary-container": "#eeefff",
                        "surface-container": "#ededf9",
                        "surface-tint": "#0053db",
                        "outline-variant": "#c3c6d7",
                        "on-tertiary-fixed": "#360f00"
                    },

                    spacing: {
                        "xs": "8px",
                        "sm": "12px",
                        "md": "16px",
                        "lg": "24px",
                        "xl": "32px",
                        "sidebar-width": "280px"
                    },

                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },

                    fontFamily: {
                        "inter": ["Inter", "sans-serif"]
                    }
                }
            }
        };
    </script>

    <style>
        body {
            font-family: "Inter", sans-serif;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body class="min-h-screen bg-background text-on-background">

    @await Component.InvokeAsync("_AdminTopNavbar")
    @await Component.InvokeAsync("_AdminSidebar")

    <main class="min-h-screen
                 bg-surface-container-lowest
                 p-md pb-24
                 md:ml-sidebar-width
                 md:pt-28 md:px-xl md:pb-xl">

        @RenderBody()

    </main>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>